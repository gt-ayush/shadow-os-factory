#!/bin/bash
#
# Registers the Shadow OS Plymouth boot splash theme.
#
# plymouth and plymouth-themes are already pulled in by
# config/package-lists/desktop.list.chroot, so no package installation is done
# here - running apt inside a chroot hook is slow and memory-heavy.

echo "Setting Plymouth theme to 'shadow'..."

if [ -d /usr/share/plymouth/themes/shadow ]; then
    plymouth-set-default-theme shadow -R || echo "WARNING: could not register plymouth theme" >&2
else
    echo "WARNING: /usr/share/plymouth/themes/shadow not found, skipping" >&2
fi
